    "provider_collision": "retain the complete native document but reject the provider view atomically"
  },
  "exclusions": [
    "configuration provider layering, reload, binding, and precedence",
    "filesystem lookup, optional files, change tokens, and writes",
    "global keys, slash comments, colon option delimiters, and continuation lines",
    "DEFAULT inheritance, interpolation, typed conversion, and caller defaults",
    "non-ASCII case-insensitive equivalence and locale-sensitive behavior",
    "partial provider Data mutation after a failed Load"
  ],
