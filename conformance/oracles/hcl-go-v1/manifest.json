{
  "suite": "consema.hcl.go-differential@1",
  "recorded_at": "2026-08-07",
  "authority": {
    "specification": "HCL Native Syntax as frozen by hashicorp/hcl v2 (hclsyntax spec)",
    "specification_url": "https://github.com/hashicorp/hcl/tree/v2.21.0/hclsyntax",
    "distribution": "github.com/hashicorp/hcl/v2 module",
    "module": "github.com/hashicorp/hcl/v2",
    "version": "v2.21.0",
    "commit": "360ae579460fab69e9939599af85c8f255a59007",
    "module_hash": "h1:lve4q/o/2rqwYOgUg3y3V2YPyD1/zkCLGjIV74Jit14=",
    "release_url": "https://github.com/hashicorp/hcl/releases/tag/v2.21.0",
    "expression_parser": "hclsyntax.ParseExpression",
    "document_parser": "hclparse.ParseHCL (hclsyntax.ParseConfig)",
    "evaluation": "never invoked; no cty evaluation, no value comparison (RFC 0014 §12)"
  },
  "runtime": {
    "go.version": "go1.26.5",
    "go.os": "windows",
    "go.arch": "amd64",
    "hcl.module": "v2.21.0",
    "windows_build": "10.0.26200.0"
  },
  "driver": {
    "source": "conformance/oracles/hcl-go-v1/main.go",
    "source_sha256": "c652af9e33621542d54b3e4d27f91f0ca67a6c021a2e3446600e73580279bedf",
    "go_mod_sha256": "bbd1c1acc83b809fc4228a424f52afc3a89eaa577d50b39cd4943361b5d37f81",
    "go_sum_sha256": "6ed4258b13184ff7ed96d6f6ef2a5bdc91b4506da97d4f454020cdef91a23158",
    "invoke_document": "hcl-go-differential.exe --document <input>",
    "invoke_expression": "hcl-go-differential.exe --expression <input>",
    "transport": "ASCII TSV; lowercase UTF-8 hex input digest; outcome accept|reject",
    "ordering": "input-sha256 line, then outcome line"
  },
  "comparison": {
    "scope": "parse outcome only: Go accept/reject versus Consema Complete/Recovered/FatalFormationFailure",
    "never_compared": [
      "cty values or any evaluated result",
      "diagnostic summaries or recovery region shapes",
      "token streams, spans, or AST shapes"
    ],
    "consema_counterpart": "Consema Complete maps to Go accept; Consema Recovered or FatalFormationFailure maps to Go reject"
  },
  "exclusions": {
    "divergence_inventory": [
      {
        "id": "D-1",
        "name": "Leading BOM",
        "oracle": "silently strips the BOM (stripUTF8BOM in scanTokens) and accepts",
        "consema": "Recovered with hcl.parse.byte-order-mark@1 (RFC 0014 §2); BOM bytes stay content, never a Bom kind",
        "kind": "exclusion"
      },
      {
        "id": "D-2",
        "name": "Lone CR",
        "oracle": "rejects (Newline = '\\r'? '\\n', so a lone CR is an invalid token)",
        "consema": "Recovered with hcl.parse.lone-cr@1 (RFC 0014 §2)",
        "kind": "exclusion (equivalent outcome: a lone CR never appears in a Complete document under either parser)"
      },
      {
        "id": "D-3",
        "name": "Invalid UTF-8",
        "oracle": "reports a parse error",
        "consema": "FatalFormationFailure with hcl.parse.invalid-utf8@1 (RFC 0012/0013 precedent)",
        "kind": "exclusion (both parsers refuse the source)"
      },
      {
        "id": "D-4",
        "name": "Underscore-leading identifiers",
        "oracle": "accepts (_foo: the scanner Ident rule admits a leading underscore)",
        "consema": "Recovered as a grammar error (Identifier = ID_Start (ID_Continue | '-')*, UAX #31)",
        "kind": "exclusion"
      },
      {
        "id": "D-5",
        "name": "Numeric attribute access foo.0",
        "oracle": "accepts (HIL-inherited: a number after a dot is an attribute step)",
        "consema": "Recovered as a grammar error (GetAttr = '.' Identifier)",
        "kind": "exclusion"
      },
      {
        "id": "D-6",
        "name": "Namespaced function calls foo::bar()",
        "oracle": "accepts (function names may be identifiers separated by '::')",
        "consema": "Recovered as a grammar error (FunctionCall = Identifier '(' ...')')",
        "kind": "exclusion"
      },
      {
        "id": "D-7",
        "name": "Single-identifier for-directive",
        "oracle": "accepts %{ for x in list } (the key is read only when a comma follows)",
        "consema": "accepts; frozen implementation behavior (RFC 0014 §4.4)",
        "kind": "frozen implementation behavior, not a divergence"
      },
      {
        "id": "D-8",
        "name": "Heredoc closing-line whitespace",
        "oracle": "matches the closing line with bytes.TrimSpace, accepting tabs and trailing whitespace",
        "consema": "accepts; frozen implementation behavior (RFC 0014 §4.5), broader than the specification's arbitrary spaces",
        "kind": "frozen implementation behavior, not a divergence"
      },
      {
        "id": "D-9",
        "name": "EOF-terminated body item",
        "oracle": "accepts end of file as the terminator of the last attribute, block, or one-line block",
        "consema": "accepts; frozen implementation behavior (RFC 0014 §4.2)",
        "kind": "frozen implementation behavior, not a divergence"
      }
    ],
    "shape_level": [
      "recovery-region boundary shape: Consema's deterministic expression recovery (RFC 0014 §3) differs from the Go parser's internal recovery; the differential never compares recovery shapes, only accept/reject",
      "duplicate-attribute treatment: both parsers reject; excluded only because the recovered piece shapes differ (Consema keeps the duplicate occurrence as a proven syntax piece)",
      "attribute/block name sharing: both parse-time structures accept it; expected-no-divergence exclusion"
    ],
    "application_layer": [
      "Terraform's static-only tfvars evaluation rule is application-layer policy (hard gate 3), never replicated at formation and never an oracle outcome",
      "Terraform's undeclared-variable rejection is application-layer (no schema in the generic HCL model, hard gate 2)",
      "Terraform's tfvars block rejection messages are loader-level behavior, not parse outcomes",
      "terraform.tfvars auto-load, .auto.tfvars naming, and -var-file precedence are CLI/application conventions, never Consema facts",
      "the JSON-based HCL syntax (.tf.json, *.auto.tfvars.json) is a separate syntax system (RFC 0014 §14) and out of scope for this differential"
    ],
    "policy": "a differential disagreement cannot be resolved by changing Consema behavior without an RFC, and no untracked allowlist exists (RFC 0014 §12)"
  },
  "skip_path": "when no Go toolchain is available, the wrapper exits with code 3 and the manifest records the allowed skip; the suite id remains consema.hcl.go-differential@1",
