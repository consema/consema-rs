{
  // Workspace defaults remain reviewable and portable.
  "editor.formatOnSave": true,
  "editor.rulers": [80, 100],
  "files.exclude": {
    "**/.cache": true,
    "**/target": true,
  },
  "search.exclude": {
    "**/dist": true,
    "**/node_modules": true,
  },
  "typescript.tsdk": "node_modules/typescript/lib",
  "terminal.integrated.env.windows": {
    "APP_ENV": "development",
  },
}
