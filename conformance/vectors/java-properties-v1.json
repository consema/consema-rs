{
  "suite": "consema.java-properties.conformance@1",
  "profiles": ["java-properties.reader@1", "java-properties.latin1@1"],
  "cases": [
    {
      "id": "formation.reader-lines-escapes-duplicates", "capability": "java-properties.document@1",
      "input": {"profile": "java-properties.reader@1", "source": "  # retained comment\\\r\nkey\\ with\\ spaces : first\\\r\n \tsecond\\u0021\ndup=first\rdup:last\nempty\nexplicit="},
      "expected": {"formation": "Complete", "natural_lines": 7, "logical_lines": 5, "comments": 1, "properties": 5, "escapes": 3, "keys": ["key with spaces", "dup", "dup", "empty", "explicit"], "values": ["firstsecond!", "first", "last", "", ""], "states": ["Present", "Present", "Present", "ImplicitEmpty", "ExplicitEmpty"], "duplicate_group": true, "exact_coverage": true}
    },
    {
      "id": "formation.empty-blank-comment-empty-key", "capability": "java-properties.document@1",
      "input": {"samples": ["", "\n", "# comment\n", "! comment\r", "implicit", "explicit=", "=value", "a=1\nb=2\n"]},
      "expected": {"formations": ["Complete", "Complete", "Complete", "Complete", "Complete", "Complete", "Complete", "Complete"], "properties": [0, 0, 0, 0, 1, 1, 1, 2], "comments": [0, 0, 1, 1, 0, 0, 0, 0]}
    },
    {
      "id": "formation.mixed-line-terminators", "capability": "java-properties.document@1",
      "input": {"profile": "java-properties.reader@1", "source": "a=1\nb=2\rc=3\r\nd=4"},
      "expected": {"natural_lines": 4, "logical_lines": 4, "properties": 4, "terminators": ["Lf", "Cr", "CrLf", "Eof"], "exact_coverage": true}
    },
    {
      "id": "formation.continuation-and-backslash-parity", "capability": "java-properties.document@1",
      "input": {"samples": [
        {"source": "key=value\\", "value_hex": "00760061006c00750065", "natural_lines": 1, "logical_lines": 1},
        {"source": "key=value\\\\", "value_hex": "00760061006c00750065005c", "natural_lines": 1, "logical_lines": 1},
        {"source": "key=first\\\n  second", "value_hex": "00660069007200730074007300650063006f006e0064", "natural_lines": 2, "logical_lines": 1},
        {"source": "key=\\u00\\\n 41", "value_hex": "0041", "natural_lines": 2, "logical_lines": 1}
      ]},
      "expected": {"all_complete": true, "exact_coverage": true}
    },
    {
      "id": "formation.escape-and-java-utf16-matrix", "capability": "java-properties.document@1",
      "input": {"profile": "java-properties.reader@1", "source": "named=\\t\\n\\r\\f\nslash=\\\\\ndropped=\\q\nnonrecursive=\\u005Cu0041\npair=\\uD83D\\uDE00\nhigh=\\uD800\nlow=\\uDC00\nhigh-before=\\uD800A\nlow-after=A\\uDC00\n"},
      "expected": {"value_utf16be_hex": ["0009000a000d000c", "005c", "0071", "005c00750030003000340031", "d83dde00", "d800", "dc00", "d8000041", "0041dc00"], "statuses": ["WellFormedUnicode", "WellFormedUnicode", "WellFormedUnicode", "WellFormedUnicode", "WellFormedUnicode", "UnpairedSurrogate", "UnpairedSurrogate", "UnpairedSurrogate", "UnpairedSurrogate"], "escape_kinds": ["Named", "Named", "Named", "Named", "Backslash", "DroppedBackslash", "Unicode", "Unicode", "Unicode", "Unicode", "Unicode", "Unicode", "Unicode"]}
    },
    {
      "id": "formation.malformed-unicode-recovery-matrix", "capability": "java-properties.formation@1",
      "input": {"samples": ["a=\\u", "a=\\u1", "a=\\u12", "a=\\u123", "a=\\u12G4", "a=\\U0041"]},
      "expected": {"formations": ["Recovered", "Recovered", "Recovered", "Recovered", "Recovered", "Complete"], "property_counts": [0, 0, 0, 0, 0, 1], "error_counts": [1, 1, 1, 1, 1, 0], "code": "java-properties.parse.malformed-unicode-escape@1", "uppercase_u_value": "U0041"}
    },
    {
      "id": "formation.reader-explicit-encodings", "capability": "java-properties.document@1",
      "input": {"samples": [
        {"encoding": "Utf8", "source_hex": "e5908d3de580bc0a", "key": "名", "value": "值", "bom": "None"},
        {"encoding": "Utf16Le", "source_hex": "fffe6b003d007600", "key": "k", "value": "v", "bom": "Some(Utf16Le)"},
        {"encoding": "Utf16Be", "source_hex": "feff006b003d0076", "key": "k", "value": "v", "bom": "Some(Utf16Be)"},
        {"encoding": "WindowsCodePage(1252)", "source_hex": "6e616d653d636166e90a", "key": "name", "value": "café", "bom": "None"}
      ]},
      "expected": {"all_complete": true, "render_identity": true, "exact_coverage": true}
    },
    {
      "id": "formation.latin1-byte-and-bom-content", "capability": "java-properties.document@1",
      "input": {"profile": "java-properties.latin1@1", "source_hex": "efbbbf6b3dff"},
      "expected": {"key_utf16be_hex": "00ef00bb00bf006b", "value_utf16be_hex": "00ff", "bom": "None", "bom_syntax": false, "exact_coverage": true}
    },
    {
      "id": "formation.recovery-never-publishes-partial-operation", "capability": "java-properties.formation@1",
      "input": {"profile": "java-properties.reader@1", "source": "good=ok\nbad=\\u12G4\nafter=yes"},
      "expected": {"formation": "Recovered", "keys": ["good", "after"], "error_lines": 1, "code": "java-properties.parse.malformed-unicode-escape@1", "projection_code": "java-properties.projection.incomplete-document@1", "edit_code": "core.edit.incomplete-target@1"}
    },
    {
      "id": "query.native-duplicates-and-escape-ownership", "capability": "java-properties.query@1",
      "input": {"profile": "java-properties.reader@1", "source": "a\\ key=one\\u0021\na\\ key=two\nempty\n", "key_utf16be_hex": "00610020006b00650079", "take": 1},
      "expected": {"duplicate_matches": 2, "escape_matches": 2, "duplicate_group": true, "escape_roles": true, "terminal": "Completed"}
    },
    {
      "id": "query.logical-and-syntax-order", "capability": "java-properties.query@1",
      "input": {"profile": "java-properties.reader@1", "logical_source": "k=one\\\r\n two\n", "syntax_source": "键=值\n", "text": "值", "raw_hex": "e994ae", "utf16be_hex": "503c"},
      "expected": {"natural_ordinals": [0, 1], "syntax_kinds": ["Key", "Value", "Value"], "syntax_role": "PropertiesSyntaxPiece", "strictly_increasing_ordinals": false}
    },
    {
      "id": "query.validation-limit-cancellation", "capability": "java-properties.query@1",
      "input": {"profile": "java-properties.reader@1", "source": "a=1\nb=2\n", "max_results": 1},
      "expected": {"invalid_argument": "key", "limit_code": "core.query.resource-limit@1", "first_yielded": true, "terminal": "Cancelled"}
    },
    {
      "id": "projection.exact-duplicates-and-fragments", "capability": "java-properties.projection@1",
      "input": {"profile": "java-properties.reader@1", "source": "a\\ key=one\\\n two\\u0021\na\\ key=last\n"},
      "expected": {"fidelity": "Exact", "keys": ["a key", "a key"], "values": ["onetwo!", "last"], "events": 0, "escape_provenance": true, "two_value_fragments": true, "association_provenance": true}
    },
    {
      "id": "projection.unpaired-and-recovered-atomic-failure", "capability": "java-properties.projection@1",
      "input": {"unpaired_source": "a=ok\nb=\\uD800", "recovered_source": "good=ok\nbad=\\u12G4"},
      "expected": {"unpaired_code": "java-properties.projection.unpaired-surrogate@1", "unpaired_start_byte": 5, "recovered_code": "java-properties.projection.incomplete-document@1", "empty_reports": true}
    },
    {
      "id": "projection.explicit-jdk-table-collapse", "capability": "java-properties.projection@1",
      "input": {"profile": "java-properties.reader@1", "source": "a=first\nb=middle\na=last\n"},
      "expected": {"unique_code": "core.projection.target-not-applicable@1", "first_fidelity": "Lossy", "event_code": "java-properties.projection.duplicate-collapsed@1", "events": 1, "first_entries": [["a", "first"], ["b", "middle"]], "last_entries": [["b", "middle"], ["a", "last"]], "collapsed_provenance": true}
    },
    {
      "id": "materialization.canonical-styles-encodings-and-closure", "capability": "java-properties.materialization@1",
      "input": {
        "reader": [[" a#", "  v:=!\\\t\b值"]],
        "latin1": [["emoji😀", "café"]],
        "utf16be": [["名", "值"]],
        "cp1252": [["name", "café"]]
      },
      "expected": {"reader_source": "\\ a\\#=\\ \\ v\\:\\=\\!\\\\\\t\\u0008值\n", "latin1_source": "emoji\\uD83D\\uDE00=caf\\u00E9\\u007F\r\n", "utf16be_decoded": "﻿名=值\r\n", "cp1252_hex": "6e616d653d636166e90a", "exact_fidelity": true, "closure": true}
    },
    {
      "id": "materialization.atomic-failures-and-limits", "capability": "java-properties.materialization@1",
      "input": {"value": [["key", "value"]], "limit_names": ["max_input_nodes", "max_output_bytes", "max_depth", "max_report_entries", "max_provenance_entries"]},
      "expected": {"scalar_code": "core.materialization.unrepresentable@1", "encoding_code": "core.materialization.unsupported-encoding@1", "limit_outcomes": ["Failed", "Failed", "Failed", "Complete", "Failed"], "limit_code": "core.materialization.resource-limit@1"}
    },
    {
      "id": "edit.all-five-operations", "capability": "java-properties.edit@1",
      "input": {"profile": "java-properties.reader@1", "source": "a=1\nb=2\n", "semantic_value": "changed", "literal_value": "raw\\ value", "new_key": "c", "new_value": "3", "renamed_key": "renamed"},
      "expected": {"outputs": ["a=changed\nb=2\n", "a=raw\\ value\nb=2\n", "a=1\nb=2\nc=3\n", "b=2\n", "renamed=1\nb=2\n"], "one_source_edit_each": true}
    },
    {
      "id": "edit.dry-run-patch-proof-conflict-atomicity", "capability": "java-properties.edit@1",
      "input": {"profile": "java-properties.reader@1", "source": "a=one\nb=two\n", "rename": "first", "value": "changed", "source_id": "fixture.properties"},
      "expected": {"source": "first=one\nb=changed\n", "edit_count": 2, "dry_run_operations": 2, "patch_replays": true, "proof_verifies": true, "conflict_code": "core.edit.conflicting-edits@1", "base_unchanged": true}
    },
    {
      "id": "resource.formation-limit-matrix", "capability": "java-properties.formation@1",
      "input": {"limits": [
        {"name": "max_source_bytes", "source": "a=1\n", "value": 2},
        {"name": "max_token_count", "source": "a=1\n", "value": 1},
        {"name": "max_node_count", "source": "a=1\n", "value": 1},
        {"name": "max_diagnostics", "source": "a=\\u\nb=\\u\n", "value": 0},
        {"name": "max_decoded_utf8_bytes", "source": "a=1\n", "value": 1},
        {"name": "max_decoded_scalars", "source": "a=1\n", "value": 1},
        {"name": "max_natural_lines", "source": "a=1\nb=2\n", "value": 1},
        {"name": "max_natural_line_bytes", "source": "long=value\n", "value": 3},
        {"name": "max_natural_line_scalars", "source": "long=value\n", "value": 3},
        {"name": "max_logical_lines", "source": "a=1\nb=2\n", "value": 1},
        {"name": "max_logical_line_natural_lines", "source": "a=one\\\n two\n", "value": 1},
        {"name": "max_logical_line_scalars", "source": "a=one\\\n two\n", "value": 3},
        {"name": "max_properties", "source": "a=1\nb=2\n", "value": 1},
        {"name": "max_comments", "source": "# a\n# b\n", "value": 1},
        {"name": "max_escapes", "source": "a=\\t\\n\n", "value": 1},
        {"name": "max_unicode_escapes", "source": "a=\\u0041\\u0042\n", "value": 1},
        {"name": "max_java_code_units_per_string", "source": "long=value\n", "value": 3},
        {"name": "max_total_java_code_units", "source": "a=1\nb=2\n", "value": 3},
        {"name": "max_duplicate_group_members", "source": "a=1\na=2\n", "value": 1},
        {"name": "max_recovery_regions", "source": "a=\\u\nb=\\u\n", "value": 1}
      ]},
      "expected": {"fatal_count": 20, "no_partial_documents": true}
    },
    {
      "id": "resource.projection-limit-matrix", "capability": "java-properties.projection@1",
      "input": {"profile": "java-properties.reader@1", "source": "a=1\n", "limits": ["max_source_associations", "max_value_nodes", "max_provenance_units"], "duplicate_source": "a=1\na=2\n"},
      "expected": {"failed_count": 4, "code": "core.projection.resource-limit@1"}
    },
    {
      "id": "registry.frozen-five-operation-surface", "capability": "java-properties.edit@1",
      "input": {"profiles": ["java-properties.reader@1", "java-properties.latin1@1"]},
      "expected": {"operations": ["java-properties.edit.insert-property@1", "java-properties.edit.remove-property@1", "java-properties.edit.rename-property@1", "java-properties.edit.replace-literal-value@1", "java-properties.edit.replace-semantic-value@1"], "supported": 5}
    },
    {
      "id": "formation.malformed-escape-in-key", "capability": "java-properties.formation@1",
      "input": {"profile": "java-properties.reader@1", "source": "\\u12G4=value\n"},
      "expected": {"formation": "Recovered", "properties": 0, "error_lines": 1, "code": "java-properties.parse.malformed-unicode-escape@1"}
    },
    {
      "id": "formation.invalid-encoding-sequence", "capability": "java-properties.formation@1",
      "input": {"profile": "java-properties.reader@1", "encoding": "Utf8", "source_hex": "6b3d76ff0a"},
      "expected": {"code": "core.source.invalid-sequence@1"}
    },
    {
      "id": "formation.bom-conflict", "capability": "java-properties.formation@1",
      "input": {"profile": "java-properties.reader@1", "encoding": "Utf8", "source_hex": "fffe6b003d007600"},
      "expected": {"code": "core.source.encoding-conflict@1"}
    }
  ]
}
