{
  "suite": "consema.source.conformance@1",
  "semantic_model": "core.semantic-model@2",
  "cases": [
    {
      "id": "source.digest.sha256-empty",
      "capability": "core.source.snapshot@1",
      "input": {"raw_hex": ""},
      "expected": {"digest": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"}
    },
    {
      "id": "source.digest.sha256-abc",
      "capability": "core.source.snapshot@1",
      "input": {"raw_hex": "616263"},
      "expected": {"digest": "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"}
    },
    {
      "id": "source.identity.equal-bytes-distinct-snapshots",
      "capability": "core.source.snapshot@1",
      "input": {"raw_hex": "5b5d"},
      "expected": {"equal_digest": true, "distinct_snapshot": true}
    },
    {
      "id": "source.encoding.utf8-roundtrip",
      "capability": "core.source.encoding@1",
      "input": {"raw_hex": "efbbbf41f09f9880", "encoding": "utf-8"},
      "expected": {"raw_hex": "efbbbf41f09f9880", "selected": "utf-8", "decoded_utf8_hex": "efbbbf41f09f9880"}
    },
    {
      "id": "source.encoding.utf16le-roundtrip",
      "capability": "core.source.encoding@1",
      "input": {"raw_hex": "fffe41003dd800de", "encoding": "utf-16le"},
      "expected": {"raw_hex": "fffe41003dd800de", "selected": "utf-16le", "decoded_utf8_hex": "efbbbf41f09f9880"}
    },
    {
      "id": "source.encoding.utf16be-roundtrip",
      "capability": "core.source.encoding@1",
      "input": {"raw_hex": "feff0041d83dde00", "encoding": "utf-16be"},
      "expected": {"raw_hex": "feff0041d83dde00", "selected": "utf-16be", "decoded_utf8_hex": "efbbbf41f09f9880"}
    },
    {
      "id": "source.encoding.latin1-roundtrip",
      "capability": "core.source.encoding@1",
      "input": {"raw_hex": "41e9ff", "encoding": "latin-1"},
      "expected": {"raw_hex": "41e9ff", "selected": "latin-1", "decoded_utf8_hex": "41c3a9c3bf"}
    },
    {
      "id": "source.encoding.binary-roundtrip",
      "capability": "core.source.encoding@1",
      "input": {"raw_hex": "fffe0000", "encoding": "binary"},
      "expected": {"raw_hex": "fffe0000", "selected": "binary", "decoded_utf8_hex": null}
    },
    {
      "id": "source.encoding.bom-declaration-conflict",
      "capability": "core.source.encoding@1",
      "input": {"raw_hex": "efbbbf41", "encoding": "utf-8", "declaration": "utf-16le"},
      "expected": {"code": "core.source.encoding-conflict@1"}
    },
    {
      "id": "source.encoding.declaration-caller-conflict",
      "capability": "core.source.encoding@1",
      "input": {"raw_hex": "41", "encoding": "utf-8", "declaration": "utf-8", "caller_override": "latin-1"},
      "expected": {"code": "core.source.encoding-conflict@1"}
    },
    {
      "id": "source.encoding.reject-utf32-bom",
      "capability": "core.source.encoding@1",
      "input": {"raw_hex": "fffe0000", "encoding": "utf-8"},
      "expected": {"code": "core.source.unsupported-bom@1"}
    },
    {
      "id": "source.encoding.reject-utf16-odd",
      "capability": "core.source.encoding@1",
      "input": {"raw_hex": "4100ff", "encoding": "utf-16le"},
      "expected": {"code": "core.source.invalid-sequence@1"}
    },
    {
      "id": "source.encoding.reject-utf16-surrogate",
      "capability": "core.source.encoding@1",
      "input": {"raw_hex": "3dd84100", "encoding": "utf-16le"},
      "expected": {"code": "core.source.invalid-sequence@1"}
    },
    {
      "id": "source.location.utf8-boundaries",
      "capability": "core.source.decoded-location@1",
      "input": {"raw_hex": "41f09f988042", "encoding": "utf-8", "raw_byte": 5, "invalid_raw_byte": 2, "invalid_utf16_offset": 2},
      "expected": {"decoded_utf8_byte": 5, "unicode_scalar_offset": 2, "utf16_code_unit_offset": 3}
    },
    {
      "id": "source.location.utf16-boundaries",
      "capability": "core.source.decoded-location@1",
      "input": {"raw_hex": "41003dd800de4200", "encoding": "utf-16le", "raw_byte": 6, "invalid_raw_byte": 3, "invalid_utf16_offset": 2},
      "expected": {"decoded_utf8_byte": 5, "unicode_scalar_offset": 2, "utf16_code_unit_offset": 3}
    },
    {
      "id": "source.location.binary-no-text",
      "capability": "core.source.decoded-location@1",
      "input": {"raw_hex": "00ff", "encoding": "binary"},
      "expected": {"code": "NoDecodedText"}
    },
    {
      "id": "source.binary.empty-coverage",
      "capability": "core.source.binary-coverage@1",
      "input": {"source_len": 0, "regions": []},
      "expected": {"region_count": 0}
    },
    {
      "id": "source.binary.region-coverage",
      "capability": "core.source.binary-coverage@1",
      "input": {"source_len": 4, "regions": [{"start": 0, "end": 1, "kind": "header"}, {"start": 1, "end": 4, "kind": "payload"}]},
      "expected": {"region_count": 2}
    },
    {
      "id": "source.binary.reject-gap",
      "capability": "core.source.binary-coverage@1",
      "input": {"source_len": 4, "regions": [{"start": 0, "end": 1, "kind": "header"}, {"start": 2, "end": 4, "kind": "payload"}]},
      "expected": {"code": "IncompleteStructuralCoverage"}
    },
    {
      "id": "source.patch.success",
      "capability": "core.source.patch@1",
      "input": {"mode": "create-apply", "base_hex": "6e616d65203d206f6c640a", "encoding": "utf-8", "replacements": [{"old_start": 0, "old_end": 0, "original_hex": "", "replacement_hex": "2320"}, {"old_start": 7, "old_end": 10, "original_hex": "6f6c64", "replacement_hex": "6e6577"}]},
      "expected": {"target_hex": "23206e616d65203d206e65770a"}
    },
    {
      "id": "source.patch.reject-stale-base",
      "capability": "core.source.patch@1",
      "input": {"mode": "stale-base", "base_hex": "616263", "stale_hex": "616264", "encoding": "utf-8", "replacements": [{"old_start": 1, "old_end": 2, "original_hex": "62", "replacement_hex": "42"}]},
      "expected": {"code": "core.source.patch-base-mismatch@1"}
    },
    {
      "id": "source.patch.reject-original-mismatch",
      "capability": "core.source.patch@1",
      "input": {"mode": "wrong-original", "base_hex": "616263", "target_hex": "614263", "encoding": "utf-8", "replacements": [{"old_start": 1, "old_end": 2, "original_hex": "78", "replacement_hex": "42"}]},
      "expected": {"code": "core.source.patch-original-mismatch@1"}
    },
    {
      "id": "source.patch.reject-overlap",
      "capability": "core.source.patch@1",
      "input": {"mode": "overlap", "base_hex": "616263646566", "encoding": "utf-8", "replacements": [{"old_start": 1, "old_end": 4, "original_hex": "626364", "replacement_hex": ""}, {"old_start": 3, "old_end": 5, "original_hex": "6465", "replacement_hex": ""}]},
      "expected": {"code": "core.protocol.invalid-value@1"}
    },
    {
      "id": "source.patch.reject-target-mismatch",
      "capability": "core.source.patch@1",
      "input": {"mode": "wrong-target", "base_hex": "6162", "encoding": "utf-8", "replacements": [{"old_start": 0, "old_end": 2, "original_hex": "6162", "replacement_hex": "6364"}]},
      "expected": {"code": "core.source.patch-target-mismatch@1"}
    },
    {
      "id": "source.patch.reject-encoding-change",
      "capability": "core.source.patch@1",
      "input": {"mode": "encoding-change", "base_hex": "6162", "target_hex": "fffe4100", "encoding": "latin-1", "replacements": [{"old_start": 0, "old_end": 2, "original_hex": "6162", "replacement_hex": "fffe4100"}]},
      "expected": {"code": "core.source.encoding-conflict@1"}
    },
    {
      "id": "source.resource.raw-limit",
      "capability": "core.source.limits@1",
      "input": {"raw_hex": "6162", "encoding": "utf-8", "max_raw_bytes": 1},
      "expected": {"code": "core.source.resource-limit@1"}
    },
    {
      "id": "source.resource.decoded-limit",
      "capability": "core.source.limits@1",
      "input": {"raw_hex": "e9", "encoding": "latin-1", "max_decoded_utf8_bytes": 1},
      "expected": {"code": "core.source.resource-limit@1"}
    },
    {
      "id": "source.resource.patch-count-limit",
      "capability": "core.source.limits@1",
      "input": {"mode": "count-limit", "base_hex": "61", "encoding": "utf-8", "max_replacements": 0, "replacements": [{"old_start": 1, "old_end": 1, "original_hex": "", "replacement_hex": "62"}]},
      "expected": {"code": "core.source.resource-limit@1"}
    }
  ]
}
